ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional OpenAI-compatible gateway (LM Studio, OpenRouter, GLM proxy, your own API)
# If set, this takes priority over Anthropic.
CUSTOM_API_KEY=
CUSTOM_API_BASE_URL=
CUSTOM_API_MODEL=
START_URL=https://www.google.com
# Persistent Chromium profile: cookies, local storage and sessions survive restarts.
BROWSER_PROFILE_DIR=.browser-profile
HEADLESS=false
MAX_STEPS=40
MEMORY_FILE=.browser-memory.json
API_TIMEOUT_SECONDS=90
